{
  "name": "oor-market-link",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:server\" \"npm:client\"",
    "server": "node backend/index.js",
    "client": "vite frontend --config frontend/vite.config.js",
    "build": "vite build frontend --config frontend/vite.config.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "start": "node backend/index.js"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "vite": "^6.3.5"
  }
}
